@@ -0,0 +1,46 @@
+package openstdio
+
+import (
+	"bytes"
+	"io"
+	"testing"
+
+	"github.com/google/uuid"
+)
+
+type fragmentedStdio struct {
+	io.Reader
+	closed bool
+}
+
+func (f *fragmentedStdio) Read(p []byte) (int, error) {
+	if len(p) > 3 {
+		p = p[:3]
+	}
+	return f.Reader.Read(p)
+}
+func (f *fragmentedStdio) Write(p []byte) (int, error) { return len(p), nil }
+func (f *fragmentedStdio) Close() error                { f.closed = true; return nil }
+
+func TestOpenStdIoReadsFragmentedUUID(t *testing.T) {
+	id := uuid.New()
+	socket := &fragmentedStdio{Reader: bytes.NewReader(id[:])}
+	connection, err := readOpenStdIoSocket(socket)
+	if err != nil || connection.ID != id {
+		t.Fatalf("fragmented UUID %v: %v", connection.ID, err)
+	}
+	if socket.closed {
+		t.Fatal("valid stdio socket closed")
+	}
+	connection.Close()
+}
+
+func TestOpenStdIoClosesTruncatedUUID(t *testing.T) {
+	socket := &fragmentedStdio{Reader: bytes.NewReader([]byte{1, 2, 3})}
+	if _, err := readOpenStdIoSocket(socket); err == nil {
+		t.Fatal("truncated UUID accepted")
+	}
+	if !socket.closed {
+		t.Fatal("failed stdio socket leaked")
+	}
+}
