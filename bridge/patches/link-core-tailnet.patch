+package dtx
+
+import (
+	"context"
+	"errors"
+	"testing"
+)
+
+func TestDriverChannelWaitHonorsCancellation(t *testing.T) {
+	connection := &Connection{requestChannelMessages: make(chan Message), closed: make(chan struct{})}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if _, err := connection.ForChannelRequestContext(ctx, nil); !errors.Is(err, context.Canceled) {
+		t.Fatalf("cancellation lost: %v", err)
+	}
+}
+
+func TestDriverChannelWaitHonorsConnectionClose(t *testing.T) {
+	connection := &Connection{requestChannelMessages: make(chan Message), closed: make(chan struct{})}
+	connection.close(ErrConnectionClosed)
+	if _, err := connection.ForChannelRequestContext(context.Background(), nil); !errors.Is(err, ErrConnectionClosed) {
+		t.Fatalf("connection close lost: %v", err)
+	}
+}
