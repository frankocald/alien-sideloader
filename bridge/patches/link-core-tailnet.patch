+	var raw map[string]interface{}
+	if err := json.Unmarshal([]byte(rsdOutput), &raw); err != nil {
+		t.Fatal(err)
+	}
+	rsd, err := parseRsdHandshakeResponse(raw)
+	if err != nil {
+		t.Fatal(err)
+	}
+	device := DeviceEntry{Address: "fd00::1", Rsd: rsd}
+	version, err := GetProductVersion(device)
+	if err != nil || version.String() != "17.0.3" {
+		t.Fatalf("version %v: %v", version, err)
+	}
+	rsd.OSVersion = ""
+	device.Rsd = rsd
+	if _, err := GetProductVersion(device); err == nil || !strings.Contains(err.Error(), "RSD peer") {
+		t.Fatalf("missing RSD version must fail without usbmuxd: %v", err)
+	}
+	rsd.OSVersion = "not-a-version"
+	device.Rsd = rsd
+	if _, err := GetProductVersion(device); err == nil || !strings.Contains(err.Error(), "invalid RSD") {
+		t.Fatalf("invalid RSD version: %v", err)
+	}
+}
+
+func TestServiceCancellationClosesOnlyOwnedSocket(t *testing.T) {
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+	device := DeviceEntry{UserspaceTUN: true, UserspaceTUNHost: "127.0.0.1", UserspaceTUNPort: listener.Addr().(*net.TCPAddr).Port}
+	accepted := make(chan error, 2)
+	go func() {
+		for range 2 {
+			conn, err := listener.Accept()
+			if err != nil {
+				accepted <- err
+				return
+			}
+			go func() {
+				defer conn.Close()
+				_, err := io.ReadFull(conn, make([]byte, 20))
+				accepted <- err
+				io.Copy(io.Discard, conn)
+			}()
+		}
+	}()
+	ctx, cancel := context.WithCancel(context.Background())
+	first, err := ConnectTUNDeviceContext(ctx, "fd00::1", 62000, device)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer first.Close()
+	if err := <-accepted; err != nil {
+		t.Fatal(err)
+	}
+	read := make(chan error, 1)
+	go func() { _, err := first.Read(make([]byte, 1)); read <- err }()
+	cancel()
+	select {
+	case err := <-read:
+		if err == nil {
+			t.Fatal("read succeeded after cancellation")
+		}
+	case <-time.After(time.Second):
+		t.Fatal("cancelled read remained blocked")
+	}
+	secondCtx, secondCancel := context.WithTimeout(context.Background(), time.Second)
+	defer secondCancel()
+	second, err := ConnectTUNDeviceContext(secondCtx, "fd00::1", 62001, device)
+	if err != nil {
+		t.Fatalf("parent forwarder must remain usable: %v", err)
+	}
+	defer second.Close()
+	if err := <-accepted; err != nil {
+		t.Fatal(err)
+	}
+}
