+package nskeyedarchiver
+
+import (
+	"bytes"
+	"strings"
+	"testing"
+
+	"howett.net/plist"
+)
+
+// This encodes the real failure-diagnostic shape: XCActivityRecord -> NSArray
+// -> XCTAttachment, whose optional userInfo points at the archive null object.
+func failureDiagnosticArchive(t *testing.T, metadata interface{}, includeMetadata bool, extra []interface{}) []byte {
+	t.Helper()
+	attachment := map[string]interface{}{
+		"$class": plist.UID(10), "lifetime": uint64(0),
+		"uniformTypeIdentifier": plist.UID(11), "fileNameOverride": plist.UID(0),
+		"timestamp": plist.UID(12), "name": plist.UID(13), "payload": plist.UID(14),
+	}
+	if includeMetadata {
+		attachment["userInfo"] = metadata
+	}
+	objects := []interface{}{
+		"$null",
+		map[string]interface{}{"$class": plist.UID(2), "finish": plist.UID(0), "start": plist.UID(0), "uuid": plist.UID(3), "title": plist.UID(5), "attachments": plist.UID(6), "activityType": plist.UID(9)},
+		map[string]interface{}{"$classname": "XCActivityRecord"},
+		map[string]interface{}{"$class": plist.UID(4), "NS.uuidbytes": make([]byte, 16)},
+		map[string]interface{}{"$classname": "NSUUID"},
+		"Failure diagnostics",
+		map[string]interface{}{"$class": plist.UID(7), "NS.objects": []interface{}{plist.UID(8)}},
+		map[string]interface{}{"$classname": "NSArray"},
+		attachment,
+		"com.apple.dt.xctest.activity-type.attachmentContainer",
+		map[string]interface{}{"$classname": "XCTAttachment"},
+		"public.plain-text",
+		float64(123),
+		"Failure diagnostic",
+		[]byte("original failure diagnostic payload"),
+	}
+	objects = append(objects, extra...)
+	data, err := plist.Marshal(map[string]interface{}{"$archiver": "NSKeyedArchiver", "$version": uint64(100000), "$objects": objects, "$top": map[string]interface{}{"root": plist.UID(1)}}, plist.BinaryFormat)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return data
+}
+
+func TestFailureDiagnosticAttachmentAllowsOptionalUserInfo(t *testing.T) {
+	for _, test := range []struct {
+		name     string
+		include  bool
+		metadata interface{}
+		extra    []interface{}
+	}{
+		{name: "absent"},
+		{name: "null UID", include: true, metadata: plist.UID(0)},
+		{name: "null sentinel", include: true, metadata: plist.UID(15), extra: []interface{}{"$null"}},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			decoded, err := Unarchive(failureDiagnosticArchive(t, test.metadata, test.include, test.extra))
+			if err != nil {
+				t.Fatal(err)
+			}
+			activity := decoded[0].(XCActivityRecord)
+			if len(activity.Attachments) != 1 {
+				t.Fatal("diagnostic attachment lost")
+			}
+			attachment := activity.Attachments[0]
+			if attachment.Name != "Failure diagnostic" || !bytes.Equal(attachment.Payload, []byte("original failure diagnostic payload")) || attachment.userInfo != nil {
+				t.Fatalf("attachment changed: %+v", attachment)
+			}
+		})
+	}
+}
+
+func TestAttachmentUserInfoDictionaryErrorsAreNotDiscarded(t *testing.T) {
+	for _, test := range []struct {
+		name     string
+		metadata interface{}
+		extra    []interface{}
+		want     string
+	}{
+		{name: "not a reference", metadata: "invalid", want: "must be an object UID"},
+		{name: "out of range", metadata: plist.UID(999), want: "out of range"},
+		{name: "not a dictionary", metadata: plist.UID(15), extra: []interface{}{"invalid"}, want: "must reference NSDictionary"},
+		{name: "malformed dictionary", metadata: plist.UID(15), extra: []interface{}{map[string]interface{}{"$class": plist.UID(16), "NS.keys": "invalid", "NS.objects": []interface{}{}}, map[string]interface{}{"$classname": "NSDictionary"}}, want: "NS.keys is not an array"},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			_, err := Unarchive(failureDiagnosticArchive(t, test.metadata, true, test.extra))
+			if err == nil || !strings.Contains(err.Error(), "XCTAttachment.userInfo") || !strings.Contains(err.Error(), test.want) {
+				t.Fatalf("malformed metadata error lost: %v", err)
+			}
+		})
+	}
+}
+
+func TestAttachmentUserInfoPreservesDictionary(t *testing.T) {
+	for _, name := range []string{"NSDictionary", "NSMutableDictionary"} {
+		t.Run(name, func(t *testing.T) {
+			extra := []interface{}{map[string]interface{}{"$class": plist.UID(16), "NS.keys": []interface{}{plist.UID(17)}, "NS.objects": []interface{}{plist.UID(18)}}, map[string]interface{}{"$classname": name}, "key", "value"}
+			decoded, err := Unarchive(failureDiagnosticArchive(t, plist.UID(15), true, extra))
+			if err != nil {
+				t.Fatal(err)
+			}
+			if decoded[0].(XCActivityRecord).Attachments[0].userInfo["key"] != "value" {
+				t.Fatal("dictionary metadata lost")
+			}
+		})
