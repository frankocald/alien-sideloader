+)
+
+const remotePairingPacketMagic = "RPPairing"
+
+// remotePairingRawConn adapts the TCP RemotePairing listener to the xpcConn
+// shape consumed by controlChannelReadWriter. The raw listener carries the
+// envelope value as JSON framed by "RPPairing" and a big-endian uint16 length;
+// the RSD untrusted service carries the same value inside RemoteXPC.
+type remotePairingRawConn struct {
+	conn net.Conn
+}
+
+func newRemotePairingRawConn(conn net.Conn) *remotePairingRawConn {
+	return &remotePairingRawConn{conn: conn}
+}
+
+func (r *remotePairingRawConn) Send(data map[string]interface{}, _ ...uint32) error {
+	value, ok := data["value"].(map[string]interface{})
+	if !ok {
+		return fmt.Errorf("remotePairingRawConn.Send: missing envelope value")
+	}
+	body, err := json.Marshal(value)
+	if err != nil {
+		return fmt.Errorf("remotePairingRawConn.Send: failed to encode JSON: %w", err)
+	}
+	if len(body) > int(^uint16(0)) {
+		return fmt.Errorf("remotePairingRawConn.Send: payload exceeds uint16 framing")
+	}
+
+	var packet bytes.Buffer
+	packet.WriteString(remotePairingPacketMagic)
+	if err := binary.Write(&packet, binary.BigEndian, uint16(len(body))); err != nil {
+		return err
+	}
+	packet.Write(body)
+	if _, err := io.Copy(r.conn, &packet); err != nil {
+		return fmt.Errorf("remotePairingRawConn.Send: failed to write packet: %w", err)
+	}
+	return nil
+}
+
+func (r *remotePairingRawConn) ReceiveOnClientServerStream() (map[string]interface{}, error) {
+	magic := make([]byte, len(remotePairingPacketMagic))
+	if _, err := io.ReadFull(r.conn, magic); err != nil {
+		return nil, fmt.Errorf("remotePairingRawConn.Receive: failed to read magic: %w", err)
+	}
+	if string(magic) != remotePairingPacketMagic {
+		return nil, fmt.Errorf("remotePairingRawConn.Receive: invalid packet magic")
+	}
+	var size uint16
+	if err := binary.Read(r.conn, binary.BigEndian, &size); err != nil {
+		return nil, fmt.Errorf("remotePairingRawConn.Receive: failed to read size: %w", err)
+	}
+	body := make([]byte, int(size))
+	if _, err := io.ReadFull(r.conn, body); err != nil {
+		return nil, fmt.Errorf("remotePairingRawConn.Receive: failed to read body: %w", err)
+	}
+	var value map[string]interface{}
+	if err := json.Unmarshal(body, &value); err != nil {
+		return nil, fmt.Errorf("remotePairingRawConn.Receive: failed to decode JSON: %w", err)
+	}
+	return map[string]interface{}{"value": value}, nil
+}
