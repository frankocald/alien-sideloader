+func TestRunnerAndDTXLogsShareSynchronization(t *testing.T) {
+	var output bytes.Buffer
+	listener := NewTestListener(&output, &output, t.TempDir())
+	var done sync.WaitGroup
+	for range 10 {
+		done.Go(func() {
+			for range 10 {
+				listener.logWriter.Write([]byte("stdout\n"))
+				listener.LogMessage("event\n")
+				listener.LogDebugMessage("debug\n")
+			}
+		})
+	}
+	done.Wait()
+	if bytes.Count(output.Bytes(), []byte("\n")) != 300 {
+		t.Fatal("concurrent output was lost")
+	}
+}
+
+func TestCancelledRunNeverStartsDeviceDiscovery(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if _, err := RunTestWithConfig(ctx, TestConfig{}); !errors.Is(err, context.Canceled) {
+		t.Fatalf("cancellation lost: %v", err)
+	}
+}
+
+func TestRejectedTestSessionIsFailure(t *testing.T) {
+	if err := requireAuthorizedTestSession(false); err == nil {
+		t.Fatal("rejected test runner accepted")
+	}
+}
+
+func TestCompletedSuiteAcceptsLateAttachmentAndSnapshotIsDetached(t *testing.T) {
+	listener := NewTestListener(nil, nil, t.TempDir())
+	listener.TestSuites = []TestSuite{{Name: "Capture", TestCases: []TestCase{{ClassName: "Capture", MethodName: "testCapture", Status: StatusPassed}}}}
+	listener.testCaseFinished("Capture", "testCapture", nskeyedarchiver.XCActivityRecord{Attachments: []nskeyedarchiver.XCTAttachment{{Name: "capture", Payload: []byte("PNG")}}})
+	suites, err := listener.resultSnapshot()
+	if err != nil || len(suites[0].TestCases[0].Attachments) != 1 {
+		t.Fatalf("late attachment missing: %+v %v", suites, err)
+	}
+	attachment := suites[0].TestCases[0].Attachments[0]
+	if data, err := os.ReadFile(attachment.Path); err != nil || string(data) != "PNG" {
+		t.Fatalf("attachment not flushed: %q %v", data, err)
+	}
+	listener.TestSuites[0].TestCases[0].Attachments[0].Name = "mutated"
+	if attachment.Name != "capture" || suites[0].TestCases[0].Attachments[0].Name != "capture" {
+		t.Fatal("snapshot aliases listener storage")
+	}
