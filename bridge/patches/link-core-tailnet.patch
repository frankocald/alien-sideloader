diff --git a/ios/connect_context.go b/ios/connect_context.go
new file mode 100644
index 0000000..8b1f134
--- /dev/null
+++ b/ios/connect_context.go
@@ -0,0 +1,67 @@
+package ios
+
+import (
+	"context"
+	"encoding/binary"
+	"fmt"
+	"net"
+	"strconv"
+	"sync"
+)
+
+// ConnectTUNDeviceContext owns one service socket, never the parent tunnel.
+// Its context covers dialing, service handshakes and subsequent RPC reads.
+func ConnectTUNDeviceContext(ctx context.Context, remoteIP string, port int, device DeviceEntry) (net.Conn, error) {
+	if port <= 0 || port > 65535 {
+		return nil, fmt.Errorf("invalid RSD service port %d", port)
+	}
+	address := net.JoinHostPort(remoteIP, strconv.Itoa(port))
+	if device.UserspaceTUN {
+		address = net.JoinHostPort(device.UserspaceTUNHost, strconv.Itoa(device.UserspaceTUNPort))
+	}
+	dialer := net.Dialer{Timeout: TunnelDialTimeout}
+	raw, err := dialer.DialContext(ctx, "tcp", address)
+	if err != nil {
+		return nil, err
+	}
+	conn := &contextServiceConn{Conn: raw}
+	conn.stop = context.AfterFunc(ctx, func() { conn.once.Do(func() { raw.Close() }) })
+	if device.UserspaceTUN {
+		ip := net.ParseIP(remoteIP).To16()
+		if ip == nil {
+			conn.Close()
+			return nil, fmt.Errorf("invalid tunnel IPv6 address")
+		}
+		if len(device.UserspaceTUNToken) != 0 {
+			if len(device.UserspaceTUNToken) != 32 {
+				conn.Close()
+				return nil, fmt.Errorf("invalid userspace tunnel credential")
+			}
+			if _, err := conn.Write(device.UserspaceTUNToken); err != nil {
+				conn.Close()
+				return nil, err
+			}
+		}
+		request := make([]byte, 20)
+		copy(request, ip)
+		binary.LittleEndian.PutUint32(request[16:], uint32(port))
+		if _, err := conn.Write(request); err != nil {
+			conn.Close()
+			return nil, err
+		}
+	}
+	return conn, nil
+}
+
+type contextServiceConn struct {
+	net.Conn
+	stop func() bool
+	once sync.Once
+}
+
+func (c *contextServiceConn) Close() error {
+	c.stop()
+	var err error
+	c.once.Do(func() { err = c.Conn.Close() })
+	return err
+}
