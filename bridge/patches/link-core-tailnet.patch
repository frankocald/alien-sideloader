+func TestUserspaceForwarderAuthentication(t *testing.T) {
+	token := bytes.Repeat([]byte{42}, 32)
+	ip := net.ParseIP("fd00::1234")
+	preamble := make([]byte, 20)
+	copy(preamble, ip.To16())
+	binary.LittleEndian.PutUint32(preamble[16:], 12345)
+	for _, kind := range []string{"valid", "wrong-token", "missing-token", "bad-destination", "bad-port"} {
+		t.Run(kind, func(t *testing.T) {
+			data := append(append([]byte{}, token...), preamble...)
+			switch kind {
+			case "wrong-token":
+				data[0] ^= 1
+			case "missing-token":
+				data = preamble
+			case "bad-destination":
+				data[32] ^= 1
+			case "bad-port":
+				binary.LittleEndian.PutUint32(data[48:], 65536)
+			}
+			c := &authTestConn{Reader: bytes.NewReader(data)}
+			iface := UserSpaceTUNInterface{authToken: token, deviceAddress: ip}
+			// Invalid inputs must be rejected before touching the nil network stack.
+			if kind == "valid" {
+				s := stack.New(stack.Options{})
+				defer s.Destroy()
+				iface.networkStack = s
+			}
+			handleUserspaceConn(iface, c)
+			if !c.closed || !c.deadline {
+				t.Fatal("connection not closed or read deadline missing")
+			}
+			if kind == "wrong-token" && c.Len() != 20 {
+				t.Fatal("read target before authentication")
+			}
+		})
+	}
+}
+
+var _ net.Conn = (*authTestConn)(nil)
+var _ io.ReadWriteCloser = (*authTestConn)(nil)
