@@ -0,0 +1,150 @@
+package tunnel
+
+import (
+	"crypto/ecdh"
+	"crypto/rand"
+	"crypto/sha512"
+	"fmt"
+	"golang.org/x/crypto/chacha20poly1305"
+	"golang.org/x/crypto/ed25519"
+	"golang.org/x/crypto/hkdf"
+	"testing"
+)
+
+type identityPeer struct {
+	key     *ecdh.PrivateKey
+	signing ed25519.PrivateKey
+	kind    string
+	writes  int
+	reply   map[string]interface{}
+}
+
+func identityEnvelope(p pairingData) map[string]interface{} {
+	return map[string]interface{}{"value": map[string]interface{}{"message": map[string]interface{}{"plain": map[string]interface{}{"_0": map[string]interface{}{"event": map[string]interface{}{"_0": p.Encode()}}}}}}
+}
+func (p *identityPeer) Send(message map[string]interface{}, _ ...uint32) error {
+	p.writes++
+	if p.writes != 1 {
+		tlv := newTlvBuffer()
+		tlv.writeByte(typeState, pairStateVerifyResponse)
+		p.reply = identityEnvelope(pairingData{data: tlv.bytes(), kind: "verifyManualPairing"})
+		return nil
+	}
+	m, err := getChildMap(message, "value", "message", "plain", "_0", "event", "_0")
+	if err != nil {
+		return err
+	}
+	var host pairingData
+	if err = host.Decode(m); err != nil {
+		return err
+	}
+	hostBytes, err := tlvReader(host.data).readCoalesced(typePublicKey)
+	if err != nil {
+		return err
+	}
+	hostKey, err := ecdh.X25519().NewPublicKey(hostBytes)
+	if err != nil {
+		return err
+	}
+	shared, err := p.key.ECDH(hostKey)
+	if err != nil {
+		return err
+	}
+	derived := make([]byte, 32)
+	if _, err = hkdf.New(sha512.New, shared, []byte("Pair-Verify-Encrypt-Salt"), []byte("Pair-Verify-Encrypt-Info")).Read(derived); err != nil {
+		return err
+	}
+	ci, err := chacha20poly1305.New(derived)
+	if err != nil {
+		return err
+	}
+	id := []byte("test-device-identity")
+	if p.kind == "identifier" {
+		id = []byte("other-device")
+	}
+	transcript := append(append(append([]byte{}, p.key.PublicKey().Bytes()...), id...), hostBytes...)
+	signature := ed25519.Sign(p.signing, transcript)
+	if p.kind == "signature" {
+		signature[0] ^= 1
+	}
+	proof := newTlvBuffer()
+	proof.writeData(typeIdentifier, id)
+	proof.writeData(typeSignature, signature)
+	nonce := make([]byte, 12)
+	copy(nonce[4:], "PV-Msg02")
+	encrypted := ci.Seal(nil, nonce, proof.bytes(), nil)
+	if p.kind == "ciphertext" {
+		encrypted[0] ^= 1
+	}
+	tlv := newTlvBuffer()
+	tlv.writeByte(typeState, pairStateStartResponse)
+	tlv.writeData(typePublicKey, p.key.PublicKey().Bytes())
+	if p.kind != "unsigned" {
+		tlv.writeData(typeEncryptedData, encrypted)
+	}
+	if p.kind == "state" {
+		tlv = newTlvBuffer()
+		tlv.writeByte(typeState, 4)
+		tlv.writeData(typePublicKey, p.key.PublicKey().Bytes())
+		tlv.writeData(typeEncryptedData, encrypted)
+	}
+	p.reply = identityEnvelope(pairingData{data: tlv.bytes(), kind: "verifyManualPairing"})
+	return nil
+}
+func (p *identityPeer) ReceiveOnClientServerStream() (map[string]interface{}, error) {
+	if p.reply == nil {
+		return nil, fmt.Errorf("no reply")
+	}
+	return p.reply, nil
+}
+func TestPairVerifyPinnedDeviceIdentity(t *testing.T) {
+	for _, kind := range []string{"valid", "unsigned", "signature", "ciphertext", "identifier", "state", "wrong-pin", "missing-pin"} {
+		t.Run(kind, func(t *testing.T) {
+			devicePub, devicePrivate, err := ed25519.GenerateKey(rand.Reader)
+			if err != nil {
+				t.Fatal(err)
+			}
+			hostPub, hostPrivate, err := ed25519.GenerateKey(rand.Reader)
+			if err != nil {
+				t.Fatal(err)
+			}
+			eph, err := ecdh.X25519().GenerateKey(rand.Reader)
+			if err != nil {
+				t.Fatal(err)
+			}
+			peer := &identityPeer{key: eph, signing: devicePrivate, kind: kind}
+			pinned := devicePub
+			if kind == "wrong-pin" {
+				pinned, _, err = ed25519.GenerateKey(rand.Reader)
+				if err != nil {
+					t.Fatal(err)
+				}
+			}
+			if kind == "missing-pin" {
+				pinned = nil
+			}
+			svc := &tunnelService{controlChannel: newControlChannelReadWriter(peer), pairRecords: PairRecordManager{peerPublicKey: pinned, peerIdentifier: "test-device-identity", selfId: selfIdentity{Identifier: "test-host", PrivateKey: hostPrivate.Seed(), PublicKey: hostPub}}}
+			err = svc.verifyPair()
+			if kind == "valid" {
+				if err != nil || svc.cipher == nil {
+					t.Fatalf("valid peer failed: %v", err)
+				}
+			} else {
+				if err == nil {
+					t.Fatal("invalid peer accepted")
+				}
+				if peer.writes > 1 {
+					t.Fatal("host identity signature released before authentication")
+				}
+				if svc.cipher != nil {
+					t.Fatal("session initialized for invalid peer")
+				}
+			}
+		})
+	}
+}
+func TestTLVTruncatedHeaderRejected(t *testing.T) {
+	if _, err := tlvReader([]byte{byte(typeSignature)}).readCoalesced(typeSignature); err == nil {
+		t.Fatal("truncated header accepted")
+	}
+}
